[
 {
  "sec": "c1",
  "t0": 0.1,
  "t1": 1.951,
  "text": "في سنة ألفين وسبعة وعشرين"
 },
 {
  "sec": "c1",
  "t0": 1.951,
  "t1": 4.297,
  "text": "أربعة رواد فضاء هيفتحوا باب ويطفوا"
 },
 {
  "sec": "c1",
  "t0": 4.297,
  "t1": 6.148,
  "text": "جوّه مركبة هبوط على القمر."
 },
 {
  "sec": "c1",
  "t0": 6.872,
  "t1": 9.011,
  "text": "بس المركبة دي مش هتكون على القمر."
 },
 {
  "sec": "c1",
  "t0": 9.574,
  "t1": 11.87,
  "text": "هتكون على ارتفاع حوالي ميتين وتلاتة"
 },
 {
  "sec": "c1",
  "t0": 11.87,
  "t1": 13.342,
  "text": "وسبعين ميل فوق الأرض"
 },
 {
  "sec": "c1",
  "t0": 13.342,
  "t1": 15.05,
  "text": "وكمان دي نسخة تجريبية بس."
 },
 {
  "sec": "c1",
  "t0": 15.564,
  "t1": 16.997,
  "text": "دي مهمة أرتميس تلاتة."
 },
 {
  "sec": "c1",
  "t0": 17.408,
  "t1": 19.137,
  "text": "ودي مش مهمة الهبوط."
 },
 {
  "sec": "c1",
  "t0": 19.627,
  "t1": 21.584,
  "text": "ولما تعرف ناسا بتختبر إيه"
 },
 {
  "sec": "c1",
  "t0": 21.584,
  "t1": 24.258,
  "text": "هتفهم ليه قدّمت المهمة دي قبل الهبوط."
 },
 {
  "sec": "c2",
  "t0": 24.764,
  "t1": 25.542,
  "text": "دي الخطة"
 },
 {
  "sec": "c2",
  "t0": 25.542,
  "t1": 27.336,
  "text": "زي ما أعلنتها ناسا بنفسها."
 },
 {
  "sec": "c2",
  "t0": 27.816,
  "t1": 30.321,
  "text": "أرتميس تلاتة هتنطلق في سنة ألفين وسبعة"
 },
 {
  "sec": "c2",
  "t0": 30.321,
  "t1": 30.977,
  "text": "وعشرين."
 },
 {
  "sec": "c2",
  "t0": 31.427,
  "t1": 34.123,
  "text": "أربعة رواد فضاء هيطيروا على متن مركبة"
 },
 {
  "sec": "c2",
  "t0": 34.123,
  "t1": 34.846,
  "text": "أوريون"
 },
 {
  "sec": "c2",
  "t0": 34.846,
  "t1": 36.49,
  "text": "القائد راندي بريسنيك"
 },
 {
  "sec": "c2",
  "t0": 36.49,
  "t1": 39.251,
  "text": "والطيار لوكا بارميتانو من وكالة الفضاء"
 },
 {
  "sec": "c2",
  "t0": 39.251,
  "t1": 40.172,
  "text": "الأوروبية"
 },
 {
  "sec": "c2",
  "t0": 40.172,
  "t1": 42.802,
  "text": "وأخصائيا المهمة أندريه دوجلاس وفرانك"
 },
 {
  "sec": "c2",
  "t0": 42.802,
  "t1": 43.459,
  "text": "روبيو."
 },
 {
  "sec": "c2",
  "t0": 44.044,
  "t1": 45.179,
  "text": "هما مش رايحين القمر."
 },
 {
  "sec": "c2",
  "t0": 45.623,
  "t1": 47.705,
  "text": "هيدخلوا مدار أرضي منخفض"
 },
 {
  "sec": "c2",
  "t0": 47.705,
  "t1": 50.456,
  "text": "في مهمة مخططة مدتها أربعتاشر يوم."
 },
 {
  "sec": "c2",
  "t0": 50.957,
  "t1": 53.702,
  "text": "صفحة الطاقم عند ناسا بتقولها بوضوح"
 },
 {
  "sec": "c2",
  "t0": 53.702,
  "t1": 56.235,
  "text": "أرتميس تلاتة مش هتهبط على القمر."
 },
 {
  "sec": "c2",
  "t0": 56.763,
  "t1": 59.08,
  "text": "الهبوط هيكون في المهمة اللي بعدها"
 },
 {
  "sec": "c2",
  "t0": 59.08,
  "t1": 60.116,
  "text": "أرتميس أربعة"
 },
 {
  "sec": "c2",
  "t0": 60.116,
  "t1": 62.25,
  "text": "وناسا مستهدفة سنة ألفين وتمانية"
 },
 {
  "sec": "c2",
  "t0": 62.25,
  "t1": 62.921,
  "text": "وعشرين"
 },
 {
  "sec": "c2",
  "t0": 62.921,
  "t1": 64.872,
  "text": "قريب من القطب الجنوبي للقمر."
 },
 {
  "sec": "c2",
  "t0": 65.478,
  "t1": 67.377,
  "text": "طب ليه نقضي مهمة كاملة قريبين من"
 },
 {
  "sec": "c2",
  "t0": 67.377,
  "t1": 67.904,
  "text": "الأرض؟"
 },
 {
  "sec": "c2",
  "t0": 68.589,
  "t1": 71.127,
  "text": "ناسا بتقول إن المهمة دي متصممة عشان"
 },
 {
  "sec": "c2",
  "t0": 71.127,
  "t1": 72.234,
  "text": "تقلل المخاطر"
 },
 {
  "sec": "c2",
  "t0": 72.234,
  "t1": 73.666,
  "text": "وتتأكد من الأجهزة"
 },
 {
  "sec": "c2",
  "t0": 73.666,
  "t1": 76.269,
  "text": "وتكسب خبرة تشغيلية قبل ما تحاول تهبط"
 },
 {
  "sec": "c2",
  "t0": 76.269,
  "t1": 77.571,
  "text": "بطاقم على القمر."
 },
 {
  "sec": "c3",
  "t0": 78.154,
  "t1": 80.469,
  "text": "المهمات اللي فاتت من أرتميس كانت"
 },
 {
  "sec": "c3",
  "t0": 80.469,
  "t1": 82.719,
  "text": "بتستخدم صاروخ ناسا ومركبتها بس."
 },
 {
  "sec": "c3",
  "t0": 83.23,
  "t1": 84.887,
  "text": "أرتميس تلاتة مختلفة."
 },
 {
  "sec": "c3",
  "t0": 85.344,
  "t1": 86.7,
  "text": "جيريمي بارسونز"
 },
 {
  "sec": "c3",
  "t0": 86.7,
  "t1": 88.913,
  "text": "مدير برنامج أرتميس في ناسا"
 },
 {
  "sec": "c3",
  "t0": 88.913,
  "t1": 89.913,
  "text": "قالها كده"
 },
 {
  "sec": "c3",
  "t0": 89.913,
  "t1": 90.698,
  "text": "اقتباس"
 },
 {
  "sec": "c3",
  "t0": 90.698,
  "t1": 93.625,
  "text": "إحنا بنطلّق تلات مركبات فضاء على تلات"
 },
 {
  "sec": "c3",
  "t0": 93.625,
  "t1": 94.91,
  "text": "صواريخ مختلفة"
 },
 {
  "sec": "c3",
  "t0": 94.91,
  "t1": 97.123,
  "text": "وبنختبر إزاي بتشتغل مع بعض"
 },
 {
  "sec": "c3",
  "t0": 97.123,
  "t1": 99.336,
  "text": "حاجة ناسا عمرها ما حاولتها."
 },
 {
  "sec": "c3",
  "t0": 99.784,
  "t1": 100.728,
  "text": "انتهى الاقتباس."
 },
 {
  "sec": "c3",
  "t0": 101.216,
  "t1": 103.36,
  "text": "التلات مركبات دول هما أوريون"
 },
 {
  "sec": "c3",
  "t0": 103.36,
  "t1": 105.959,
  "text": "ونسخة تجريبية من مركبة بلو مون بتاعة"
 },
 {
  "sec": "c3",
  "t0": 105.959,
  "t1": 106.934,
  "text": "بلو أوريجن"
 },
 {
  "sec": "c3",
  "t0": 106.934,
  "t1": 109.533,
  "text": "ونسخة تجريبية من مركبة ستارشيب بتاعة"
 },
 {
  "sec": "c3",
  "t0": 109.533,
  "t1": 110.378,
  "text": "سبيس إكس."
 },
 {
  "sec": "c3",
  "t0": 110.877,
  "t1": 111.966,
  "text": "نسخ تجريبية"
 },
 {
  "sec": "c3",
  "t0": 111.966,
  "t1": 113.667,
  "text": "مش مركبات هبوط جاهزة."
 },
 {
  "sec": "c3",
  "t0": 114.154,
  "t1": 116.695,
  "text": "الفكرة إننا نشوف بيتصرفوا إزاي مع بعض"
 },
 {
  "sec": "c3",
  "t0": 116.695,
  "t1": 118.086,
  "text": "وفيه ناس على متنهم."
 },
 {
  "sec": "c4",
  "t0": 118.749,
  "t1": 119.516,
  "text": "الخطوة الأولى."
 },
 {
  "sec": "c4",
  "t0": 119.991,
  "t1": 122.473,
  "text": "بلو أوريجن بتطلّق النسخة التجريبية من"
 },
 {
  "sec": "c4",
  "t0": 122.473,
  "t1": 124.713,
  "text": "بلو مون مارك تو في مدار دائري على"
 },
 {
  "sec": "c4",
  "t0": 124.713,
  "t1": 127.195,
  "text": "ارتفاع حوالي ميتين وتلاتة وسبعين ميل."
 },
 {
  "sec": "c4",
  "t0": 127.787,
  "t1": 130.238,
  "text": "ناسا بتقول إنها تقدر تفضل هناك لحد"
 },
 {
  "sec": "c4",
  "t0": 130.238,
  "t1": 131.206,
  "text": "تلاتين يوم."
 },
 {
  "sec": "c4",
  "t0": 131.95,
  "t1": 132.74,
  "text": "الخطوة التانية."
 },
 {
  "sec": "c4",
  "t0": 133.22,
  "t1": 134.422,
  "text": "بعدها بأيام بس"
 },
 {
  "sec": "c4",
  "t0": 134.422,
  "t1": 136.572,
  "text": "لما تتأكد إن المركبة دي سليمة"
 },
 {
  "sec": "c4",
  "t0": 136.572,
  "t1": 139.166,
  "text": "ناسا بتطلّق أوريون فوق صاروخ إس إل إس"
 },
 {
  "sec": "c4",
  "t0": 139.166,
  "t1": 141.506,
  "text": "من مركز كينيدي للفضاء في فلوريدا."
 },
 {
  "sec": "c4",
  "t0": 142.034,
  "t1": 143.997,
  "text": "أوريون بتبدأ في مدار ممدود"
 },
 {
  "sec": "c4",
  "t0": 143.997,
  "t1": 146.403,
  "text": "وبعدين بتستخدم وحدة الخدمة بتاعتها"
 },
 {
  "sec": "c4",
  "t0": 146.403,
  "t1": 148.746,
  "text": "عشان تنتقل لمدار دائري على ارتفاع"
 },
 {
  "sec": "c4",
  "t0": 148.746,
  "t1": 150.962,
  "text": "حوالي تلتميت وخمسة وأربعين ميل."
 },
 {
  "sec": "c4",
  "t0": 151.537,
  "t1": 154.322,
  "text": "ومن هناك بتجهّز ببطء للالتقاء بالمركبة"
 },
 {
  "sec": "c4",
  "t0": 154.322,
  "t1": 155.118,
  "text": "التانية."
 },
 {
  "sec": "c4",
  "t0": 155.635,
  "t1": 157.346,
  "text": "أول يومين بيكونوا فحوصات."
 },
 {
  "sec": "c4",
  "t0": 157.72,
  "t1": 160.257,
  "text": "الطاقم بيختبر أنظمة أوريون ويجهّز"
 },
 {
  "sec": "c4",
  "t0": 160.257,
  "t1": 162.451,
  "text": "لحاجة اسمها عمليات الاقتراب"
 },
 {
  "sec": "c4",
  "t0": 162.451,
  "t1": 164.987,
  "text": "يعني الطيران بالقرب من مركبة فضاء"
 },
 {
  "sec": "c4",
  "t0": 164.987,
  "t1": 165.673,
  "text": "تانية."
 },
 {
  "sec": "c4",
  "t0": 166.347,
  "t1": 167.174,
  "text": "الخطوة التالتة."
 },
 {
  "sec": "c4",
  "t0": 167.656,
  "t1": 169.896,
  "text": "أوريون بتلتحم بالنسخة التجريبية من بلو"
 },
 {
  "sec": "c4",
  "t0": 169.896,
  "t1": 170.323,
  "text": "مون."
 },
 {
  "sec": "c4",
  "t0": 170.774,
  "t1": 173.068,
  "text": "وبعدها الطاقم بيقضي حوالي يومين في"
 },
 {
  "sec": "c4",
  "t0": 173.068,
  "t1": 173.793,
  "text": "تقييمها."
 },
 {
  "sec": "c4",
  "t0": 174.257,
  "t1": 175.346,
  "text": "بيفتحوا الباب"
 },
 {
  "sec": "c4",
  "t0": 175.346,
  "t1": 176.375,
  "text": "ويدخلوا جوّه"
 },
 {
  "sec": "c4",
  "t0": 176.375,
  "t1": 178.855,
  "text": "ويفحصوا الكابينة وأجهزة التحكم وأنظمة"
 },
 {
  "sec": "c4",
  "t0": 178.855,
  "t1": 179.763,
  "text": "دعم الحياة."
 },
 {
  "sec": "c4",
  "t0": 180.256,
  "t1": 182.484,
  "text": "وناسا بتقول إنها هتتأكد كمان إن"
 },
 {
  "sec": "c4",
  "t0": 182.484,
  "t1": 184.967,
  "text": "المركبة تقدر تحافظ على الغلاف الجوي"
 },
 {
  "sec": "c4",
  "t0": 184.967,
  "t1": 186.304,
  "text": "والضغط المناسبين."
 },
 {
  "sec": "c4",
  "t0": 186.642,
  "t1": 189.177,
  "text": "ودي هتكون أول مرة ناسا تقيّم فيها"
 },
 {
  "sec": "c4",
  "t0": 189.177,
  "t1": 191.78,
  "text": "مركبة هبوط تجارية على القمر وعليها"
 },
 {
  "sec": "c4",
  "t0": 191.78,
  "t1": 192.397,
  "text": "طاقم."
 },
 {
  "sec": "c4",
  "t0": 193.38,
  "t1": 194.174,
  "text": "الخطوة الرابعة."
 },
 {
  "sec": "c4",
  "t0": 194.707,
  "t1": 197.388,
  "text": "أوريون بتفك الالتحام وتغيّر مكانها."
 },
 {
  "sec": "c4",
  "t0": 198.292,
  "t1": 199.175,
  "text": "الخطوة الخامسة."
 },
 {
  "sec": "c4",
  "t0": 199.672,
  "t1": 201.866,
  "text": "سبيس إكس بتطلّق نسخة تجريبية من"
 },
 {
  "sec": "c4",
  "t0": 201.866,
  "t1": 204.249,
  "text": "ستارشيب الإصدار التالت من فلوريدا."
 },
 {
  "sec": "c4",
  "t0": 204.759,
  "t1": 206.692,
  "text": "بتدخل مدار أقل ارتفاعًا"
 },
 {
  "sec": "c4",
  "t0": 206.692,
  "t1": 209.453,
  "text": "وبتشيل نظام التحام إضافي في مقدمتها."
 },
 {
  "sec": "c4",
  "t0": 210.074,
  "t1": 212.89,
  "text": "أوريون بتلتحم بيها في اختبار ممكن يمتد"
 },
 {
  "sec": "c4",
  "t0": 212.89,
  "t1": 213.896,
  "text": "لحد ساعتين."
 },
 {
  "sec": "c4",
  "t0": 214.452,
  "t1": 215.222,
  "text": "المرة دي"
 },
 {
  "sec": "c4",
  "t0": 215.222,
  "t1": 216.702,
  "text": "الطاقم مش بيدخل جوّه."
 },
 {
  "sec": "c4",
  "t0": 217.244,
  "t1": 219.616,
  "text": "وبعدها فيه لحد خمس أيام تانيين من"
 },
 {
  "sec": "c4",
  "t0": 219.616,
  "t1": 220.578,
  "text": "الاختبارات."
 },
 {
  "sec": "c4",
  "t0": 221.031,
  "t1": 222.222,
  "text": "بدلات الفضاء"
 },
 {
  "sec": "c4",
  "t0": 222.222,
  "t1": 223.694,
  "text": "وحساسات الالتحام"
 },
 {
  "sec": "c4",
  "t0": 223.694,
  "t1": 226.077,
  "text": "وقياسات الضوضاء ودرجة الحرارة"
 },
 {
  "sec": "c4",
  "t0": 226.077,
  "t1": 227.619,
  "text": "وشوية تجارب علمية"
 },
 {
  "sec": "c4",
  "t0": 227.619,
  "t1": 230.352,
  "text": "منها دراسة عن إزاي رواد الفضاء ممكن"
 },
 {
  "sec": "c4",
  "t0": 230.352,
  "t1": 233.226,
  "text": "يعملوا فحوصات صحية لما ميقدروش يكلموا"
 },
 {
  "sec": "c4",
  "t0": 233.226,
  "t1": 234.347,
  "text": "مركز التحكم."
 },
 {
  "sec": "c5",
  "t0": 234.977,
  "t1": 236.578,
  "text": "فيه تفصيلة سهل تفوتك."
 },
 {
  "sec": "c5",
  "t0": 236.987,
  "t1": 239.617,
  "text": "المركبتين مش بيتوصلوا بنفس الطريقة."
 },
 {
  "sec": "c5",
  "t0": 240.134,
  "t1": 242.737,
  "text": "أوريون بتتوصّل بفتحة جنب كابينة الطاقم"
 },
 {
  "sec": "c5",
  "t0": 242.737,
  "t1": 243.666,
  "text": "في بلو مون."
 },
 {
  "sec": "c5",
  "t0": 244.115,
  "t1": 244.805,
  "text": "وبعدها"
 },
 {
  "sec": "c5",
  "t0": 244.805,
  "t1": 247.437,
  "text": "بتظبّط نظام الالتحام الأمامي بتاعها مع"
 },
 {
  "sec": "c5",
  "t0": 247.437,
  "t1": 249.506,
  "text": "النظام اللي في مقدمة ستارشيب."
 },
 {
  "sec": "c5",
  "t0": 249.954,
  "t1": 251.819,
  "text": "طريقتين مختلفتين للتوصيل"
 },
 {
  "sec": "c5",
  "t0": 251.819,
  "t1": 252.977,
  "text": "في مهمة واحدة."
 },
 {
  "sec": "c5",
  "t0": 253.478,
  "t1": 256.181,
  "text": "وناسا بتقول إن ده بيدّيها فرصة تقارن"
 },
 {
  "sec": "c5",
  "t0": 256.181,
  "t1": 258.411,
  "text": "بين طريقتين مختلفتين للتشغيل"
 },
 {
  "sec": "c5",
  "t0": 258.411,
  "t1": 260.776,
  "text": "وتجمع بيانات هندسية عن الاتنين."
 },
 {
  "sec": "c5",
  "t0": 261.373,
  "t1": 262.942,
  "text": "في التحام ستارشيب"
 },
 {
  "sec": "c5",
  "t0": 262.942,
  "t1": 265.724,
  "text": "ناسا وسبيس إكس بيخططوا يقيّموا إزاي"
 },
 {
  "sec": "c5",
  "t0": 265.724,
  "t1": 267.793,
  "text": "الزوج الملتحم بيتحكم فيه"
 },
 {
  "sec": "c5",
  "t0": 267.793,
  "t1": 269.22,
  "text": "وإزاي بيتواصلوا"
 },
 {
  "sec": "c5",
  "t0": 269.22,
  "t1": 271.645,
  "text": "وإزاي البرمجيات بتشتغل مع بعض"
 },
 {
  "sec": "c5",
  "t0": 271.645,
  "t1": 274.57,
  "text": "وشكل القوى وقت الالتحام وفك الالتحام."
 },
 {
  "sec": "c6",
  "t0": 275.484,
  "t1": 278.271,
  "text": "دلوقتي الجزء اللي بيخلّي المهمة دي"
 },
 {
  "sec": "c6",
  "t0": 278.271,
  "t1": 278.931,
  "text": "صعبة."
 },
 {
  "sec": "c6",
  "t0": 279.523,
  "t1": 282.416,
  "text": "ستارشيب متصممة تفضل في المدار وقت أقصر"
 },
 {
  "sec": "c6",
  "t0": 282.416,
  "t1": 284.483,
  "text": "بكتير من مركبة بلو أوريجن."
 },
 {
  "sec": "c6",
  "t0": 284.979,
  "t1": 287.109,
  "text": "علشان كده إطلاقها بيجي متأخر في"
 },
 {
  "sec": "c6",
  "t0": 287.109,
  "t1": 287.778,
  "text": "المهمة."
 },
 {
  "sec": "c6",
  "t0": 288.206,
  "t1": 290.93,
  "text": "والنسخة التجريبية من بلو مون بتستنى في"
 },
 {
  "sec": "c6",
  "t0": 290.93,
  "t1": 292.616,
  "text": "المدار لحد تلاتين يوم."
 },
 {
  "sec": "c6",
  "t0": 293.127,
  "t1": 296.11,
  "text": "ناسا بتسمّي ده كله حملة منسّقة بعناية"
 },
 {
  "sec": "c6",
  "t0": 296.11,
  "t1": 296.838,
  "text": "شديدة."
 },
 {
  "sec": "c6",
  "t0": 297.483,
  "t1": 299.184,
  "text": "وهنا بييجي السؤال"
 },
 {
  "sec": "c6",
  "t0": 299.184,
  "t1": 300.343,
  "text": "لو حصل إيه؟"
 },
 {
  "sec": "c6",
  "t0": 300.822,
  "t1": 302.48,
  "text": "لو حتة واحدة اتأخرت؟"
 },
 {
  "sec": "c6",
  "t0": 303.057,
  "t1": 304.061,
  "text": "هقولك بصراحة"
 },
 {
  "sec": "c6",
  "t0": 304.061,
  "t1": 305.832,
  "text": "في صفحات ناسا اللي قريتها"
 },
 {
  "sec": "c6",
  "t0": 305.832,
  "t1": 306.717,
  "text": "مفيش إجابة."
 },
 {
  "sec": "c6",
  "t0": 307.245,
  "t1": 309.868,
  "text": "رقم التلاتين يوم هو المرونة في الجدول"
 },
 {
  "sec": "c6",
  "t0": 309.868,
  "t1": 312.171,
  "text": "اللي ناسا بتذكرها لجانب بلو مون."
 },
 {
  "sec": "c6",
  "t0": 312.684,
  "t1": 315.482,
  "text": "خطة ناسا المنشورة مبتقولش إيه تأثير أي"
 },
 {
  "sec": "c6",
  "t0": 315.482,
  "t1": 317.947,
  "text": "مشكلة في المدار على هدف سنة ألفين"
 },
 {
  "sec": "c6",
  "t0": 317.947,
  "t1": 319.213,
  "text": "وتمانية وعشرين."
 },
 {
  "sec": "c6",
  "t0": 319.785,
  "t1": 322.868,
  "text": "علشان كده أنا بعتبر أي تاريخ في القصة"
 },
 {
  "sec": "c6",
  "t0": 322.868,
  "t1": 323.695,
  "text": "دي هدف"
 },
 {
  "sec": "c6",
  "t0": 323.695,
  "t1": 324.522,
  "text": "مش وعد."
 },
 {
  "sec": "c7",
  "t0": 325.495,
  "t1": 327.469,
  "text": "وفيه حاجة غريبة أغلب التغطيات"
 },
 {
  "sec": "c7",
  "t0": 327.469,
  "t1": 328.306,
  "text": "بتتخطّاها."
 },
 {
  "sec": "c7",
  "t0": 328.809,
  "t1": 329.733,
  "text": "في الأول"
 },
 {
  "sec": "c7",
  "t0": 329.733,
  "t1": 332.363,
  "text": "ستارشيب بتاعة سبيس إكس كانت مخصصة"
 },
 {
  "sec": "c7",
  "t0": 332.363,
  "t1": 334.14,
  "text": "لأرتميس تلاتة وأربعة"
 },
 {
  "sec": "c7",
  "t0": 334.14,
  "t1": 336.628,
  "text": "ومركبة بلو أوريجن لأرتميس خمسة."
 },
 {
  "sec": "c7",
  "t0": 337.08,
  "t1": 339.319,
  "text": "وبعدين ناسا عدّلت العقود."
 },
 {
  "sec": "c7",
  "t0": 339.798,
  "t1": 342.195,
  "text": "دلوقتي الشركتين بيشاركوا في أرتميس"
 },
 {
  "sec": "c7",
  "t0": 342.195,
  "t1": 342.826,
  "text": "تلاتة"
 },
 {
  "sec": "c7",
  "t0": 342.826,
  "t1": 343.71,
  "text": "في المدار"
 },
 {
  "sec": "c7",
  "t0": 343.71,
  "t1": 346.044,
  "text": "ومفيش واحدة فيهم مخصصة لمهمة هبوط"
 },
 {
  "sec": "c7",
  "t0": 346.044,
  "t1": 346.738,
  "text": "بعينها."
 },
 {
  "sec": "c7",
  "t0": 347.215,
  "t1": 348.636,
  "text": "وناسا بتقول إنها"
 },
 {
  "sec": "c7",
  "t0": 348.636,
  "t1": 351.004,
  "text": "بناءً على جاهزية مركبات الهبوط"
 },
 {
  "sec": "c7",
  "t0": 351.004,
  "t1": 353.777,
  "text": "هتقرر أنهي شركة هتكون الأولى في توصيل"
 },
 {
  "sec": "c7",
  "t0": 353.777,
  "t1": 356.281,
  "text": "رواد فضاء لسطح القمر في سنة ألفين"
 },
 {
  "sec": "c7",
  "t0": 356.281,
  "t1": 357.566,
  "text": "وتمانية وعشرين."
 },
 {
  "sec": "c7",
  "t0": 358.034,
  "t1": 360.76,
  "text": "وبعدها بتيجي فرصة هبوط تانية بطاقم."
 },
 {
  "sec": "c7",
  "t0": 361.298,
  "t1": 363.571,
  "text": "وقبل ما أي طاقم يطير للقمر"
 },
 {
  "sec": "c7",
  "t0": 363.571,
  "t1": 366.577,
  "text": "الشركتين لازم يطيّروا مهمة تجريبية من"
 },
 {
  "sec": "c7",
  "t0": 366.577,
  "t1": 369.583,
  "text": "غير طاقم بمركبة الهبوط المخصصة للبشر."
 },
 {
  "sec": "c7",
  "t0": 370.123,
  "t1": 372.868,
  "text": "وناسا بتقول إنها هتعتمد مركبات الهبوط"
 },
 {
  "sec": "c7",
  "t0": 372.868,
  "t1": 373.537,
  "text": "الأول."
 },
 {
  "sec": "c7",
  "t0": 374.182,
  "t1": 376.563,
  "text": "يعني أرتميس تلاتة مش مجرد اختبار"
 },
 {
  "sec": "c7",
  "t0": 376.563,
  "t1": 377.357,
  "text": "للأجهزة."
 },
 {
  "sec": "c7",
  "t0": 377.786,
  "t1": 380.226,
  "text": "دي كمان معلومات هتستخدمها ناسا وهي"
 },
 {
  "sec": "c7",
  "t0": 380.226,
  "t1": 381.767,
  "text": "بتقرر الخطوة الجاية."
 },
 {
  "sec": "c8",
  "t0": 382.516,
  "t1": 383.818,
  "text": "في مهمة الهبوط"
 },
 {
  "sec": "c8",
  "t0": 383.818,
  "t1": 386.353,
  "text": "مركبة هبوط تجارية بتلتحم بأوريون."
 },
 {
  "sec": "c8",
  "t0": 386.639,
  "t1": 388.975,
  "text": "وبعدين بتنزل بتنين من الطاقم على"
 },
 {
  "sec": "c8",
  "t0": 388.975,
  "t1": 389.624,
  "text": "السطح"
 },
 {
  "sec": "c8",
  "t0": 389.624,
  "t1": 391.896,
  "text": "وبيفضل التانيين على متن أوريون."
 },
 {
  "sec": "c8",
  "t0": 392.311,
  "t1": 394.616,
  "text": "خطة سبيس إكس بتبدأ بأسطول."
 },
 {
  "sec": "c8",
  "t0": 395.025,
  "t1": 397.623,
  "text": "كذا ستارشيب بتنطلق لمدار أرضي منخفض"
 },
 {
  "sec": "c8",
  "t0": 397.623,
  "t1": 398.755,
  "text": "كناقلات وقود"
 },
 {
  "sec": "c8",
  "t0": 398.755,
  "t1": 401.219,
  "text": "وبتنقل وقود فائق البرودة لستارشيب"
 },
 {
  "sec": "c8",
  "t0": 401.219,
  "t1": 401.819,
  "text": "مخزن"
 },
 {
  "sec": "c8",
  "t0": 401.819,
  "t1": 404.483,
  "text": "واللي بيمدّ مركبة الهبوط بالوقود بعد"
 },
 {
  "sec": "c8",
  "t0": 404.483,
  "t1": 405.016,
  "text": "كده."
 },
 {
  "sec": "c8",
  "t0": 405.487,
  "t1": 407.805,
  "text": "مركبة الهبوط بتستنى في مدار الأرض."
 },
 {
  "sec": "c8",
  "t0": 408.207,
  "t1": 409.753,
  "text": "أوريون بتلتحم بيها"
 },
 {
  "sec": "c8",
  "t0": 409.753,
  "t1": 412.577,
  "text": "وستارشيب بتعمل إشعال محرك يبعت الاتنين"
 },
 {
  "sec": "c8",
  "t0": 412.577,
  "t1": 413.989,
  "text": "لمدار قمري منخفض."
 },
 {
  "sec": "c8",
  "t0": 414.482,
  "t1": 416.835,
  "text": "وناسا بتقول إنها بتشتغل على تعديل"
 },
 {
  "sec": "c8",
  "t0": 416.835,
  "t1": 419.188,
  "text": "أوريون علشان ستارشيب تقدر تدفعها."
 },
 {
  "sec": "c8",
  "t0": 419.61,
  "t1": 422.038,
  "text": "وبعدين بينزل اتنين من الطاقم لعدة"
 },
 {
  "sec": "c8",
  "t0": 422.038,
  "t1": 422.628,
  "text": "أيام."
 },
 {
  "sec": "c8",
  "t0": 423.111,
  "t1": 426.022,
  "text": "خطة بلو أوريجن بتستخدم تلات مراحل نقل."
 },
 {
  "sec": "c8",
  "t0": 426.416,
  "t1": 428.059,
  "text": "بتنطلق لمدار الأرض"
 },
 {
  "sec": "c8",
  "t0": 428.059,
  "t1": 430.916,
  "text": "وبعدها مركبة الهبوط بلو مون مارك تو."
 },
 {
  "sec": "c8",
  "t0": 431.301,
  "t1": 432.523,
  "text": "ولما يلتحموا"
 },
 {
  "sec": "c8",
  "t0": 432.523,
  "t1": 435.11,
  "text": "المجموعة بتتجه لمدار قطبي بيضاوي"
 },
 {
  "sec": "c8",
  "t0": 435.11,
  "t1": 436.331,
  "text": "حوالين القمر"
 },
 {
  "sec": "c8",
  "t0": 436.331,
  "t1": 438.99,
  "text": "وكل مرحلة بتنفصل لما وقودها يخلص."
 },
 {
  "sec": "c8",
  "t0": 439.389,
  "t1": 441.874,
  "text": "أوريون بتنطلق وتلتحم بمركبة الهبوط"
 },
 {
  "sec": "c8",
  "t0": 441.874,
  "t1": 442.463,
  "text": "هناك."
 },
 {
  "sec": "c8",
  "t0": 442.823,
  "t1": 444.915,
  "text": "واتنين من الطاقم بينزلوا على القطب"
 },
 {
  "sec": "c8",
  "t0": 444.915,
  "t1": 445.906,
  "text": "الجنوبي للقمر."
 },
 {
  "sec": "c8",
  "t0": 446.341,
  "t1": 448.862,
  "text": "وناسا بتقول إن الخطتين بتحلّوا محل"
 },
 {
  "sec": "c8",
  "t0": 448.862,
  "t1": 451.515,
  "text": "فكرة أقدم كانت بتقضي بالتقاء في مدار"
 },
 {
  "sec": "c8",
  "t0": 451.515,
  "t1": 452.643,
  "text": "هالو شبه خطي"
 },
 {
  "sec": "c8",
  "t0": 452.643,
  "t1": 455.031,
  "text": "لأن المدارات الجديدة بتخلّي رحلة"
 },
 {
  "sec": "c8",
  "t0": 455.031,
  "t1": 457.22,
  "text": "العودة من السطح لأوريون أسرع."
 },
 {
  "sec": "c8",
  "t0": 457.646,
  "t1": 460.377,
  "text": "وناسا أعلنت كمان عن بدلة فضاء تانية"
 },
 {
  "sec": "c8",
  "t0": 460.377,
  "t1": 460.937,
  "text": "أخف"
 },
 {
  "sec": "c8",
  "t0": 460.937,
  "t1": 462.407,
  "text": "اسمها بدلة سورتي"
 },
 {
  "sec": "c8",
  "t0": 462.407,
  "t1": 465.137,
  "text": "وزنها تقريبًا نص وزن البدلة الأكبر"
 },
 {
  "sec": "c8",
  "t0": 465.137,
  "t1": 467.938,
  "text": "علشان تساعد في أول مشاوير على القمر."
 },
 {
  "sec": "c9",
  "t0": 468.436,
  "t1": 469.157,
  "text": "تلات حاجات."
 },
 {
  "sec": "c9",
  "t0": 469.589,
  "t1": 470.043,
  "text": "واحد."
 },
 {
  "sec": "c9",
  "t0": 470.466,
  "t1": 473.234,
  "text": "ناسا بتقول إن أجهزة أرتميس تلاتة ماشية"
 },
 {
  "sec": "c9",
  "t0": 473.234,
  "t1": 474.223,
  "text": "في الميعاد"
 },
 {
  "sec": "c9",
  "t0": 474.223,
  "t1": 476.727,
  "text": "وأوقات التجهيز اتقلّت بحوالي النص."
 },
 {
  "sec": "c9",
  "t0": 477.154,
  "t1": 477.612,
  "text": "اتنين."
 },
 {
  "sec": "c9",
  "t0": 478.022,
  "t1": 480.653,
  "text": "ناسا بتقول إنها أعادت تصميم وصنع"
 },
 {
  "sec": "c9",
  "t0": 480.653,
  "t1": 483.429,
  "text": "واختبار جزء حيوي في خط الوقود جوّه"
 },
 {
  "sec": "c9",
  "t0": 483.429,
  "t1": 484.964,
  "text": "ناسا في خمس شهور"
 },
 {
  "sec": "c9",
  "t0": 484.964,
  "t1": 487.375,
  "text": "بحوالي عُشر تقدير خارجي سابق."
 },
 {
  "sec": "c9",
  "t0": 487.717,
  "t1": 488.929,
  "text": "ده كلام ناسا نفسها."
 },
 {
  "sec": "c9",
  "t0": 489.387,
  "t1": 489.782,
  "text": "تلاتة."
 },
 {
  "sec": "c9",
  "t0": 490.187,
  "t1": 492.019,
  "text": "تابع اختبارات الالتحام نفسها."
 },
 {
  "sec": "c9",
  "t0": 492.434,
  "t1": 494.213,
  "text": "كل حاجة تانية بتعتمد عليها."
 },
 {
  "sec": "c9",
  "t0": 494.656,
  "t1": 495.991,
  "text": "لو الفيديو ده فادك"
 },
 {
  "sec": "c9",
  "t0": 495.991,
  "t1": 496.572,
  "text": "اشترك."
 },
 {
  "sec": "c9",
  "t0": 496.961,
  "t1": 498.283,
  "text": "في الفيديو الجاي"
 },
 {
  "sec": "c9",
  "t0": 498.283,
  "t1": 500.864,
  "text": "هتكلم عن إزاي ستارشيب بتتزوّد بالوقود"
 },
 {
  "sec": "c9",
  "t0": 500.864,
  "t1": 501.745,
  "text": "في المدار"
 },
 {
  "sec": "c9",
  "t0": 501.745,
  "t1": 503.193,
  "text": "وليه ده مهم للهبوط."
 }
]